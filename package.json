{
  "name": "ai-diagnostic-ru",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.8.1 <27"
  },
  "scripts": {
    "dev": "next dev --webpack --hostname 127.0.0.1",
    "build": "next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "playwright test",
    "test:unit": "vitest run",
    "worker:consultation": "node --env-file=.env.local --import tsx scripts/consultation-worker.ts",
    "worker": "exec node --env-file-if-exists=.env.local --import tsx scripts/worker.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.116.0",
    "decimal.js": "^10.6.0",
    "next": "16.3.4",
    "openai": "^7.13.0",
    "playwright": "^1.63.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.5.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "postcss": "8.5.28",
    "supabase": "2.117.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.13",
    "typescript": "6.0.3",
    "vitest": "^5.0.0"
  }
}
