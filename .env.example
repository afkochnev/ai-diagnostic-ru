# Supabase Connect dialog / Project Settings > API Keys (publishable, NOT service_role).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=
# Exact public app origin; no trailing slash. Use HTTPS in production.
APP_URL=http://127.0.0.1:3000
# Generate with: openssl rand -hex 32. Server-only; never expose in NEXT_PUBLIC_*.
AUTH_FLOW_SECRET=
# Optional links. These defaults explicitly display temporary legal placeholders.
DATA_PROCESSING_POLICY_URL=/ru/legal/data-processing
MARKETING_POLICY_URL=/ru/legal/marketing
# Server-only Supabase service role key, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=
# Stage 7B email adapter. Server-only; Resend API key must never be exposed to the browser.
EMAIL_PROVIDER=resend
# Optional Team invitation override, reuses RESEND_API_KEY/EMAIL_FROM.
# Keep report and consultation mail mock while accepting real Team invitations.
TEAM_INVITATION_EMAIL_PROVIDER=mock
# V2.5 access emails stay mock until an explicitly approved real smoke.
ACQUISITION_EMAIL_PROVIDER=mock
# Optional isolated loopback Team acceptance; ignored in production.
TEAM_LOCAL_ACCEPTANCE=0
RESEND_API_KEY=
EMAIL_FROM=
# Server-only administrator destination for consultation notifications.
CONSULTATION_NOTIFICATION_EMAIL=
INTERNAL_WORKER_SECRET=
# Worker operations (server-only; safe pilot defaults)
WORKER_POLL_INTERVAL_MS=2000
WORKER_LEASE_SECONDS=300
SCORING_MAX_ATTEMPTS=3
AI_MAX_ATTEMPTS=3
CONSULTATION_MAX_ATTEMPTS=5
AI_PROVIDER_TIMEOUT_MS=180000
AI_CONCURRENCY=1
# Team AI is isolated from legacy AI. Defaults to mock, including staging acceptance.
TEAM_AI_PROVIDER=mock
# Optional, used only with explicit TEAM_AI_PROVIDER=openai; real calls require rollout approval.
TEAM_AI_MODEL=

# V2.6A: mock checkout only on the exact staging project or local test pair. Default off.
BILLING_ENABLED=false
BILLING_PROVIDER=mock
# APP_URL is the canonical public origin (PUBLIC_APP_URL equivalent).
# Mock signature uses a domain-separated HMAC with server-only AUTH_FLOW_SECRET.
# Real provider credentials are deliberately not configured.

# V2.6B YooKassa: future sandbox only; no real-money production support in this release.
# Price, currency, VAT and term come only from docs/v26b-commercial-config.json.
# Keep BILLING_PROVIDER=mock until separately approved sandbox rollout.
YOOKASSA_TEST_MODE=true
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_VAT_CODE=1
# Obtain actual receipt settings before making even a sandbox payment. No default mode.
YOOKASSA_PAYMENT_MODE=full_payment
YOOKASSA_PAYMENT_MODE_CONFIRMED=false
YOOKASSA_RECEIPT_CONFIG_CONFIRMED=false
# yookassa or external, from confirmed merchant configuration
YOOKASSA_RECEIPT_SOLUTION=
YOOKASSA_RECEIPT_MEASURE=
YOOKASSA_RECEIPT_REQUIRES_MEASURE=
YOOKASSA_RECEIPT_REQUIRES_TAX_SYSTEM_CODE=
# Only when required, confirmed by merchant/accounting; USN subtype is never inferred.
YOOKASSA_TAX_SYSTEM_CODE=
YOOKASSA_TAX_SYSTEM_CODE_CONFIRMED=false

# V2.7: stop new checkouts with BILLING_ENABLED=false while retaining verified
# reconciliation. A provider incident can separately stop all verification.
YOOKASSA_RECONCILIATION_ENABLED=true
# Full refund initiation is independently OFF. No production provider support.
YOOKASSA_REFUNDS_ENABLED=false
# Confirm full-refund receipt behavior in the actual selected merchant solution.
# Accepted value after confirmation: from_original_payment. Never infer it.
YOOKASSA_REFUND_RECEIPT_MODE=

# Production environment capabilities remain OFF until separately approved.
# Exact APP_URL + Supabase project pairing is always required.
ACQUISITION_ENABLED=false
TEAM_ENABLED=false
# Creation kill switches are separate from existing sessions/Team access/jobs.
ACQUISITION_START_ENABLED=false
TEAM_CREATION_ENABLED=false
TEAM_INVITATIONS_ENABLED=false
# Corresponding private.launch_controls DB gates also default to false.
